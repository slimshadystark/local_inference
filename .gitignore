# Local tooling and large files
/.tools
/.natives
/.fvm/
*.gguf
.DS_Store

# Dart and Flutter build output
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
pubspec_overrides.yaml
**/.swiftpm/

# Lock files of the workspace and the examples: a library repository does not pin its users' versions. The doctor's
# test fixtures keep theirs (the doctor reads a host's lock).
/pubspec.lock
/packages/*/pubspec.lock
/packages/*/example/pubspec.lock
